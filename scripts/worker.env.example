# Where the CV worker finds everything, when it runs on your own machine.
#
# Every value here is one the API service already has. Copy this file to
# scripts/worker.env and fill them in - that copy is gitignored, so the
# credentials stay on your machine.

# Redis, carrying the job queue.
#
# The EXTERNAL url, not the internal one: the internal address only resolves
# inside the host's own network. On Render this is under the Key Value
# instance, and external connections have to be enabled on it first.
REDIS_URL=rediss://red-xxxxx:PASSWORD@HOST.render.com:6379

# Object storage. Host only - no https:// prefix.
MINIO_ENDPOINT=ACCOUNT_ID.r2.cloudflarestorage.com
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_USE_SSL=true
BUCKET_PRIVATE=orbit-private
BUCKET_PUBLIC=orbit-public

# The API, for reporting results back to.
API_BASE_URL=https://orbit-6ux0.onrender.com
